# LoJix FM environment template
# Copy to .env and fill secrets before running installer

# Domain
DOMAIN=lojix.my.id

# Database (MySQL)
# Replace these with site-specific credentials on the server only
DB_USER=sql_lojix_my_id
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_NAME=sql_lojix_my_id

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=

# Icecast
ICECAST_SOURCE_PASSWORD=sourcepass
ICECAST_ADMIN_PASSWORD=adminpass

# Piper / OpenAI
PIPER_MODEL=tts_model
OPENAI_API_KEY=

# Frontend / WebSocket
FRONTEND_URL=https://lojix.my.id
NEXT_PUBLIC_API_URL=https://lojix.my.id/api
NEXT_PUBLIC_STREAM_URL=https://lojix.my.id/live
NEXT_PUBLIC_WS_URL=wss://lojix.my.id/ws

# Discord bot
DISCORD_TOKEN=
BOT_API_KEY=
DISCORD_WEBHOOK=


# Grafana
GRAFANA_PASSWORD=
